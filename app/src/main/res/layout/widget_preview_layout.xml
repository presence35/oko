<?xml version="1.0" encoding="utf-8"?>
<!--
  Static picker preview of the standard (4x2) widget, shown on Android 12+ via
  android:previewLayout. Uses real views (icons, colored pills/chips) so the picker
  shows exactly what the widget looks like, instead of a hand-drawn mock.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <!-- Accent bar -->
    <View
        android:layout_width="6dp"
        android:layout_height="90dp"
        android:background="#E53935" />

    <Space
        android:layout_width="10dp"
        android:layout_height="1dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Header: trident + title + status pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="28dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_trident" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="#FFD700"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_preview_pill"
                android:backgroundTint="#1E88E5"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="Backup"
                android:textColor="#000000"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="12dp" />

        <!-- Threat icon + count + distance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="Ballistic threat"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_threat_ballistic" />

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="#E6E6E6"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="10dp" />

        <!-- Zone chip -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_preview_pill"
            android:backgroundTint="#FDD835"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:text="Yellow zone"
            android:textColor="#000000"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>