<?xml version="1.0" encoding="utf-8"?>
<!-- Sideload (beta) flavor only. The self-update path downloads an APK and hands it to the
     system installer, which needs REQUEST_INSTALL_PACKAGES and a FileProvider content URI.
     Neither is present in the Play flavor, so the store build cannot install APKs. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
